# FSD C-10.1 target esp32s3 is set by `idf.py set-target esp32s3`.
# FSD C-10.3: 16 MB flash, stated rather than left to a default.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# FSD C-10.6: custom partition table, two 4 MB OTA slots.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# FSD C-10.8: bootloader rolls back an image that never confirms (FR-5.24).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# FSD C-10.5: console on USB-Serial/JTAG (EN/BOOT not proven wired on SLOT1).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# FSD FR-19.1, NFR-19.1: task watchdog, 10 s, restarts the chip (panic) on timeout.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y

# FSD FR-21.5: the user key (GPIO 21, active low) also wakes the chip from deep sleep.
CONFIG_DEEP_SLEEP_WAKE_GPIO=21

# FSD FR-22.1, FR-22.2: time server and zone (POSIX TZ string, fixed at build time).
CONFIG_TIME_SYNC_SERVER="pool.ntp.org"
CONFIG_TIME_SYNC_TZ="EST5EDT,M3.2.0,M11.1.0"
