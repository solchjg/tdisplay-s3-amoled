# FSD C-10.1 target esp32s3 is set by `idf.py set-target esp32s3`.
# FSD C-10.3: 16 MB flash, stated rather than left to a default.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# FSD C-10.6: custom partition table, two 4 MB OTA slots.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# FSD C-10.8: bootloader rolls back an image that never confirms (FR-5.24).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# FSD C-10.5: console on USB-Serial/JTAG (EN/BOOT not proven wired on SLOT1).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# FSD FR-19.1, NFR-19.1: task watchdog, 10 s, restarts the chip (panic) on timeout.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y

# FSD FR-21.5: the user key (GPIO 21, active low) also wakes the chip from deep sleep.
CONFIG_DEEP_SLEEP_WAKE_GPIO=21

# FSD FR-22.1, FR-22.2: time server and zone (POSIX TZ string, fixed at build time).
CONFIG_TIME_SYNC_SERVER="pool.ntp.org"
CONFIG_TIME_SYNC_TZ="EST5EDT,M3.2.0,M11.1.0"

# FSD FR-24.11: the BOOT key, next to the LED that blinks in the hold, ends it too.
CONFIG_SETUP_CHECK_KEY2_GPIO=0

# FSD FR-25.5: verify a chain whose top certificate is a cross-signed root (Gmail sends
# GTS Root R1 signed by GlobalSign Root CA, which the bundle no longer holds).
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# FSD §25.2: the WiFi and nine mail fields, percent-encoded, fit.
CONFIG_PORTAL_BODY_MAX=2048
CONFIG_PORTAL_WIFI_SWITCH=y
# BLE setup (FSD §26): NimBLE, one central, at most 3 bonds kept in NVS (FR-26.13).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# GATT client (needs the central role): confirms the indication a phone sends on
# connecting; unconfirmed, the phone drops the link after 30 s (ble_setup.h).
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BLE_SETUP_BOND=y
CONFIG_BLE_SETUP_BODY_MAX=2048
# FR-26.19: the field rules with the loop (§29) and alert (§31.2) fields outgrow the 2048 default
CONFIG_BLE_SETUP_FORM_MAX=6144
