# FSD FR-35.22: the T-SIM7080G bench build with the 1.3" OLED on GPIO 13/21
# standing in for the SSD1322. Applied after sdkconfig.tsim7080g; never released.
CONFIG_APP_OLED_STANDIN=y
# An SSD1306 instead: CONFIG_APP_OLED_STANDIN_SH1106=n
# GPIO 21 is the stand-in's SCL, so the user key is the BOOT key (GPIO 0) and
# only the timer wakes the chip (GPIO 0 is a strapping pin: no key wake).
CONFIG_SETUP_CHECK_KEY_GPIO=0
CONFIG_SETUP_CHECK_KEY2_GPIO=-1
CONFIG_DEEP_SLEEP_WAKE_GPIO=-1
