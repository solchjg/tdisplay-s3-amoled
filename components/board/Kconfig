menu "Board"

    choice APP_BOARD
        prompt "Board this build runs on"
        default APP_BOARD_TDISPLAY_S3_AMOLED
        help
            FSD §35 (FR-35.5): one source tree, the board chosen at build time.

        config APP_BOARD_TDISPLAY_S3_AMOLED
            bool "LilyGO T-Display-S3 AMOLED 1.91\""

        config APP_BOARD_TSIM7080G_S3
            bool "LilyGO T-SIM7080G-S3 (FSD §35)"

    endchoice

    config APP_OLED_STANDIN
        bool "Bench stand-in: the 1.3\" OLED on GPIO 13/21 (never released)"
        depends on APP_BOARD_TSIM7080G_S3
        default n
        help
            FSD FR-35.22: draws the six lines on a 128 x 64 SSD1306 or SH1106
            on GPIO 13 (SDA) and GPIO 21 (SCL) instead of the SSD1322, 21
            characters a line. RS232 and the off-board key are off in this
            build. A bench build until the SSD1322 is fitted; never released.

    config APP_OLED_STANDIN_SH1106
        bool "The stand-in is an SH1106 (most 1.3\" modules)"
        depends on APP_OLED_STANDIN
        default y
        help
            Off for an SSD1306.

endmenu
