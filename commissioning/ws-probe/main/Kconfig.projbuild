menu "Waveshare SIM7670G probe"

config PROBE_APN
    string "APN of the SIM (empty leaves the modem's own)"
    default "hologram"

config PROBE_REGISTER_S
    int "Seconds to wait for the modem to register"
    default 120
    range 10 600

config PROBE_GNSS_S
    int "Seconds of GNSS search (0: none)"
    default 0
    range 0 1800

config PROBE_WALK_S
    int "Seconds each header pin toggles in the pin walk (0: no walk)"
    default 4
    range 0 30

config PROBE_SLEEP_S
    int "Seconds of each deep sleep for the current measurement"
    default 60
    range 10 600

endmenu
