# The Unexpected Maker FeatherS3D (16 MB flash), one app, console on the
# ESP32-S3's own USB-Serial/JTAG (FSD §40.2).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# The card's commands at debug level in the probe's SD test (esp_log_level_set).
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
