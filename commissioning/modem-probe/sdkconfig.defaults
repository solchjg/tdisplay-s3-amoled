# The LilyGO T-SIM7080G-S3 (16 MB flash), one large app, console on USB-Serial/JTAG.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# PPP over the SIM7080G's UART (esp_modem).
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_NOTIFY_PHASE_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_PPP_ENABLE_IPV6=n
CONFIG_ESP_MODEM_C_API_STR_MAX=512
# lwIP statistics, for the PPP byte counts (with MIB2_STATS in CMakeLists.txt).
CONFIG_LWIP_STATS=y
