menu "Modem probe"

config PROBE_APN
    string "APN of the SIM (e.g. iot.1nce.net for 1NCE, hologram for Hologram)"
    default "iot.1nce.net"

choice PROBE_RAT
    prompt "Radio access"
    default PROBE_RAT_CATM
    config PROBE_RAT_CATM
        bool "LTE-M only (AT+CMNB=1)"
    config PROBE_RAT_NB
        bool "NB-IoT only (AT+CMNB=2)"
    config PROBE_RAT_BOTH
        bool "LTE-M and NB-IoT (AT+CMNB=3)"
endchoice

config PROBE_PLMN
    string "Network to lock to, as MCC and MNC (empty: automatic)"
    default ""
    help
        E.g. 310260 T-Mobile, 310410 AT&T, 311480 Verizon. Sent as
        AT+COPS=1,2,"<PLMN>" on a full attach; with it empty a previous lock
        is undone with AT+COPS=0.

config PROBE_PLMN_FALLBACK
    bool "Prefer that network, falling back to automatic choice"
    depends on PROBE_PLMN != ""
    default n
    help
        Sends AT+COPS=4 instead of AT+COPS=1: the modem tries the named
        network first and chooses another itself when it cannot register.

config PROBE_ATTACH_S
    int "Seconds to wait for network registration"
    range 30 600
    default 180

config PROBE_TB_URL
    string "ThingsBoard base URL (empty: no telemetry POST)"
    default ""
    help
        As tb_url of FSD 32.2, e.g. https://tb.example.org. Use a test device:
        every run posts one record.

config PROBE_TB_TOKEN
    string "ThingsBoard device access token"
    default ""
    help
        For a local build only; CI leaves it empty. A settings image flashed
        at 0x9000 (namespace "probe", key "tb_token") overrides it.

config PROBE_NTFY_URL
    string "ntfy server base URL (empty: no alert)"
    default ""

config PROBE_NTFY_TOPIC
    string "ntfy topic"
    default ""
    help
        For a local build only; CI leaves it empty. A settings image flashed
        at 0x9000 (namespace "probe", key "ntfy_topic") overrides it.

config PROBE_NTFY_TOKEN
    string "ntfy access token (empty: none)"
    default ""
    help
        For a local build only; CI leaves it empty. A settings image flashed
        at 0x9000 (namespace "probe", key "ntfy_token") overrides it.

config PROBE_GPS
    bool "Seek one GPS fix on the first run (LTE off meanwhile; needs the GPS antenna)"
    default n

config PROBE_GPS_LIMIT_S
    int "Seconds to wait for the GPS fix"
    depends on PROBE_GPS
    range 60 3600
    default 1200

config PROBE_PSM
    bool "Ask the network for PSM (TAU 1 h, active time 10 s)"
    default n

config PROBE_OLED_SH1106
    bool "The status screen is an SH1106 (most 1.3 inch modules) rather than an SSD1306"
    default n

config PROBE_OLED_SDA
    int "Status screen SDA GPIO (-1: no screen)"
    range -1 48
    default 13

config PROBE_OLED_SCL
    int "Status screen SCL GPIO"
    range 0 48
    default 21

config PROBE_EVERY_MIN
    int "Minutes between runs (0: run once, then print the signal every 30 s)"
    range 0 1440
    default 0
    help
        Above 0 the probe is a soak test: after each run the ESP32-S3 deep-sleeps
        until the next one. Without PSM the modem is powered down between runs,
        so each run is a cold attach.

endmenu
