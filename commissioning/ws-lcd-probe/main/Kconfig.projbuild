menu "Waveshare 1.9in LCD probe"

config PROBE_SPI_MHZ
    int "SPI clock in MHz"
    default 2
    range 1 62
    help
        The ST7789 takes up to 62.5 MHz on short traces; jumper wires on a
        shared bus may need less. Raise it once the pattern is clean.

config PROBE_LANDSCAPE
    bool "Landscape (320 x 170) instead of portrait (170 x 320)"
    default y

config PROBE_PIN_CS
    int "LCD CS GPIO"
    default 3
    help
        3 is the e-paper's CS line (§36), free with the e-paper unplugged;
        19 is the one free header pin when the e-paper stays wired.

config PROBE_PIN_RST
    int "LCD RST GPIO (-1: RST tied to 3V3, software reset)"
    default 20
    range -1 48

config PROBE_PIN_BL
    int "LCD BL GPIO, driven high after start (-1: BL tied to 3V3)"
    default 1
    range -1 48

config PROBE_BLINK
    bool "Only blink every LCD line as a GPIO (3 s high, 3 s low) for a meter"
    default y
    help
        The panel is never started: CS, DC, CLK, DIN, RST and BL all go high
        and low together every 3 s, forever, so each can be checked
        with a meter at the LCD's own connector.

endmenu
